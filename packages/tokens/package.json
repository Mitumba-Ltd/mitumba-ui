{
  "name": "@mitumba/tokens",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitumba-Ltd/mitumba-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Mitumba-Ltd/mitumba-ui/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/Mitumba-Ltd/mitumba-ui/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "^3.1.4"
  }
}
